;; The BUSINESSNZ source catalog, as Kotoba.
;;
;; GENERATED by scripts/gen-kotoba-port.cljs from data/datascript-tx.edn,
;; which src/association/facts.cljc holds as data. Both are the same
;; catalog; this one reaches the Kotoba oracle, wasm and both native ISAs,
;; which the .cljc cannot. Do not hand-edit -- run the generator, and
;; `--check` will tell you if someone did.
;;
;; `:topic` is a SET in the source. A set has no order and `topic` is
;; indexed by position, so the generator uses the order the data file
;; writes. `by-topic-id` answers by name and is unaffected.
;;
;; Parity: test/association_facts_kotoba_parity_test.clj compares every
;; field of every entry against the .cljc, so this file cannot drift from
;; the data without the suite saying so.

(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [a :string] :bool (string=? a "businessnz"))

(defn entry-count [a :string] :i64 (if (association-covered? a) 13 0))

(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (< i 0) false (< i 13)) false))

