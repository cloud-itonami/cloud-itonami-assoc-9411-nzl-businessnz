{:paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]
         ;; amu is TEST-ONLY, for the catalog parity gate: it compiles
         ;; `src/association_facts.kotoba` and runs it against the `.cljc` that
         ;; reads the same `data/datascript-tx.edn`. Nothing at runtime compiles.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "f5cf064366591ea729441b41143cc99e18e8239a"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
